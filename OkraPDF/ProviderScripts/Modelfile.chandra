# okra-chandra: Chandra OCR 2 configured for document parsing over Ollama.
#
# `ollama create okra-chandra:q4 -f Modelfile.chandra` layers config over the
# already-pulled base blob (no re-download). Baking num_ctx here is required
# because Ollama's OpenAI-compatible /v1 endpoint ignores a per-request num_ctx,
# and a page image's vision tokens (~3.8k) otherwise overflow the default 4k
# window and truncate the parse. temperature 0 keeps extraction deterministic.
FROM ahmgam/chandra-ocr-2:q4
PARAMETER num_ctx 8192
PARAMETER temperature 0
