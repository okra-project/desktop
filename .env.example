# OkraPDF Desktop - Environment Variables
# Copy this file to .env and fill in values as needed

# ============================================
# REQUIRED: API Keys for Document Processing
# ============================================

# OpenAI API key for OCR and document understanding
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google AI API key (alternative to OpenAI)
# Get yours at: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# ============================================
# OPTIONAL: Telemetry (disabled by default)
# ============================================

# Sentry error tracking - only enable if you want to report errors
# SENTRY_DSN=
# OKRAPDF_SENTRY_DSN=

# PostHog analytics - only enable if you want usage analytics
# POSTHOG_KEY=
# POSTHOG_HOST=https://us.i.posthog.com

# ============================================
# OPTIONAL: macOS Code Signing (for releases)
# ============================================

# Apple Developer credentials for code signing
# Only needed if building signed releases for distribution
# APPLE_ID=
# APPLE_APP_SPECIFIC_PASSWORD=
# APPLE_TEAM_ID=
# CSC_LINK=
# CSC_KEY_PASSWORD=
